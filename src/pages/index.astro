---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Hero from '../components/Hero.astro';
import GalleryImage from '../components/GalleryImage.astro';

const products = [
	{
		title: 'Impresiones',
		description: 'Impresiones A4 en blanco y negro o color. Con o sin anillado.',
		image: '/impresiones_FOT_1.webp',
		url: '/calculadoras/impresiones',
		destacado: true,
		tags: ['impresiones']
	},
	// {
	// 	title: 'Stickers',
	// 	description: 'Stickers en blanco y negro o color.',
	// 	image: '/stickers_FOT_1.webp',
	// 	url: '/calculadoras/stickers',
	// 	destacado: true,
	// 	tags: ['stickers']
	// },
	// {
	// 	title: 'Etiquetas',
	// 	description: 'Etiquetas en blanco y negro o color.',
	// 	image: '/etiquetas_FOT_1.webp',
	// 	url: '/calculadoras/etiquetas',
	// 	destacado: false,
	// 	tags: ['impresiones']
	// }
];

const gallery = [
	"/g1.jfif",
	"/g2.jfif",
	"/g3.jfif",
];

const advantages = [
	{
		icon: "🤝",
		title: "Atención personalizada",
		description: "Cada pedido se revisa de forma individual para asegurar el mejor resultado.",
	},
	{
		icon: "⚡",
		title: "Entrega rápida",
		description: "Trabajos realizados en tiempos reducidos según disponibilidad.",
	},
	{
		icon: "📦",
		title: "Pedidos pequeños y grandes",
		description: "Desde una sola impresión hasta producciones más grandes.",
	},
	{
		icon: "💬",
		title: "Presupuesto instantáneo",
		description: "Calculá el precio online y consultá cualquier duda por WhatsApp.",
	},
];

const faqs = [
	{
		question: "¿Cómo realizo un pedido?",
		answer: "Calculá tu presupuesto online y luego envianos un mensaje por WhatsApp con los detalles y los archivos a imprimir.",
	},
	{
		question: "¿Qué formatos de archivo aceptan?",
		answer: "Aceptamos PDF, JPG, PNG y otros formatos de imagen habituales.",
	},
	{
		question: "¿Cuánto demora la entrega?",
		answer: "El tiempo de entrega depende del trabajo solicitado y la cantidad requerida.",
	},
	{
		question: "¿Realizan pedidos pequeños?",
		answer: "Sí, trabajamos tanto con pedidos pequeños como con cantidades mayores.",
	},
	{
		question: "¿Puedo solicitar un presupuesto sin compromiso?",
		answer: "Sí, podés calcular un precio estimado online o consultarnos directamente por WhatsApp.",
	},
	{
		question: "¿Dónde se retiran los pedidos?",
		answer: "La coordinación de entrega o retiro se realiza directamente por WhatsApp.",
	},
	{
		question: "¿No encontrás el producto que buscás?",
		answer: "Escribinos por WhatsApp y contanos qué necesitás. Podemos evaluar trabajos personalizados."
	}
];
---

<Layout>
	<Hero />

	<section id="productos" class="py-16">
		<div class="mx-auto max-w-7xl px-4">
			<p class="text-center text-sm font-semibold uppercase tracking-wider text-green-600">
				Nuestros productos
			</p>

			<h2 class="mt-2 text-center text-3xl font-bold">
				Encontrá lo que necesitás
			</h2>

			<p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
				Calculá tu presupuesto online y realizá tu pedido de forma rápida
				por WhatsApp.
			</p>
			<!-- <nav>
				<ul class="mt-10 flex flex-wrap justify-center gap-4">
					<li>
						<button
							class="button-nav-tags button-nav-tags-active cursor-pointer rounded-lg bg-amber-300 px-6 py-3 font-semibold transition hover:bg-amber-400"
						>
							Destacados
						</button>
					</li>
					<li>
						<button
							class="button-nav-tags button-nav-tags-active cursor-pointer rounded-lg bg-amber-300 px-6 py-3 font-semibold transition hover:bg-amber-400"
						>
							Impresiones
						</button>
					</li>
					<li>
						<button
							class="button-nav-tags button-nav-tags-active cursor-pointer rounded-lg bg-amber-300 px-6 py-3 font-semibold transition hover:bg-amber-400"
						>
							Stickers
						</button>
					</li>
					<li>
						<button
							class="button-nav-tags button-nav-tags-active cursor-pointer rounded-lg bg-amber-300 px-6 py-3 font-semibold transition hover:bg-amber-400"
						>
							Todos
						</button>
					</li>
				</ul>
			</nav> -->
			<div class="mt-10 mx-auto grid max-w-6xl gap-6 px-4 md:grid-cols-2 lg:grid-cols-4">
				{
					products.map((product) => (
						<ProductCard
						title={product.title}
						description={product.description}
						image={product.image}
						calculatorUrl={product.url}
						/>
					))
				}
			</div>
		</div>
	</section>

	<!-- <section id="galeria" class="bg-gray-50 py-16">
		<div class="mx-auto max-w-7xl px-4">
			<p class="text-center text-sm font-semibold uppercase tracking-wider text-green-600">
				Galería
			</p>

			<h2 class="mt-2 text-center text-3xl font-bold">
				Trabajos realizados
			</h2>

			<p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
				Algunos ejemplos de impresiones, stickers y etiquetas realizadas para clientes.
			</p>

			<div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{
					gallery.map((image) => (
						<GalleryImage
							src={image}
							alt="Trabajo realizado"
						/>
					))
				}
			</div>
		</div>
	</section> -->

	<section id="ventajas" class="py-16">
		<div class="mx-auto max-w-7xl px-4">
			<p class="text-center text-sm font-semibold uppercase tracking-wider text-green-600">
				¿Por qué elegirnos?
			</p>

			<h2 class="mt-2 text-center text-3xl font-bold">
				Ventajas de trabajar con nosotros
			</h2>

			<p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
				Buscamos ofrecer una experiencia simple, rápida y personalizada para cada cliente.
			</p>

			<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{
					advantages.map((advantage) => (
						<article class="rounded-xl border bg-white p-6 text-center shadow-md transition hover:shadow-lg">
							<div class="text-4xl">
								{advantage.icon}
							</div>

							<h3 class="mt-4 text-lg font-bold">
								{advantage.title}
							</h3>

							<p class="mt-2 text-sm text-gray-600">
								{advantage.description}
							</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="faq" class="bg-gray-50 py-16">
		<div class="mx-auto max-w-5xl px-4">
			<p class="text-center text-sm font-semibold uppercase tracking-wider text-green-600">
				Preguntas frecuentes
			</p>

			<h2 class="mt-2 text-center text-3xl font-bold">
				Resolvemos tus dudas
			</h2>

			<p class="mx-auto mt-4 max-w-2xl text-center text-gray-600">
				Estas son algunas de las consultas más habituales que recibimos.
			</p>

			<div class="mt-10 flex flex-col gap-4">
				{
					faqs.map((faq) => (
						<details class="rounded-xl border bg-white p-5 shadow-sm transition hover:shadow-md">
							<summary class="cursor-pointer font-semibold">
								{faq.question}
							</summary>

							<p class="mt-3 text-sm leading-relaxed text-gray-600">
								{faq.answer}
							</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16">
		<div class="mx-auto max-w-5xl px-4">
			<div
				class="rounded-2xl bg-linear-to-b from-green-300 to-green-200 px-8 py-12 text-center shadow-md"
			>
				<p class="text-sm font-semibold uppercase tracking-wider text-green-700">
					¿Listo para comenzar?
				</p>

				<h2 class="mt-2 text-3xl font-bold md:text-4xl">
					Hacé tu pedido hoy mismo
				</h2>

				<p class="mx-auto mt-4 max-w-2xl text-gray-700">
					Calculá tu presupuesto online o escribinos directamente por WhatsApp.
					Estamos listos para ayudarte con tu próximo trabajo.
				</p>

				<div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
					<a
						href="#productos"
						class="rounded-lg bg-amber-300 px-6 py-3 font-semibold transition hover:bg-amber-400"
					>
						Calcular precio
					</a>

					<a
						href="https://wa.me/5492932417209?text=Hola%20Rinc%C3%B3n%20Gr%C3%A1fico,%20quer%C3%ADa%20pedir%20presupuesto%20para:%0A%0AProducto:%20%0ACantidad:%20%0ADetalles:%20"
						target="_blank"
						class="rounded-lg bg-green-600 px-6 py-3 font-semibold text-white transition hover:bg-green-700"
					>
						Escribinos por WhatsApp
					</a>
					<p class="mt-6 text-sm text-gray-600">
						📍 Punta Alta · Atención personalizada · Presupuesto sin compromiso
					</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
