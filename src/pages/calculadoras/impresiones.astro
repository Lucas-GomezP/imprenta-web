---
import Layout from "../../layouts/Layout.astro";
import CalculadoraImpresion from "../../components/calculadoras/CalculadoraImpresion";
import GalleryImage from "../../components/GalleryImage.astro";
import { getPreciosImpresion, getPreciosAnillado }from "../../lib/googleSheets";
type Row = Record<string, string>;
const preciosImpresion = await getPreciosImpresion() as Row[];
const preciosAnillado = await getPreciosAnillado() as Row[];

const gallery = [
  "/impresiones_FOT_1.webp",
  "/impresiones_FOT_1.webp",
  "/impresiones_FOT_1.webp",
];

// @ts-ignore

const precios = {
  bn: {
    simple: parseInt(preciosImpresion[0]["PVP Final"] ?? 0),
    doble: parseInt(preciosImpresion[1]["PVP Final"] ?? 0)
  },
  color: {
    simple: parseInt(preciosImpresion[2]["PVP Final"] ?? 0),
    doble: parseInt(preciosImpresion[3]["PVP Final"] ?? 0)
  },
};

const anillados = [
  {
    maxHojas: parseInt(preciosAnillado[0]["Cantidad Hojas"] ?? 0),
    precio: parseInt(preciosAnillado[0]["PVP Final"] ?? 0),
  },
  {
    maxHojas: parseInt(preciosAnillado[1]["Cantidad Hojas"] ?? 0),
    precio: parseInt(preciosAnillado[1]["PVP Final"] ?? 0),
  }
];
---

<Layout>
  <section class="pt-16">
    <div class="mx-auto max-w-5xl px-4">
      <div class="rounded-2xl bg-linear-to-b from-green-300 to-green-200 px-8 py-12 text-center shadow-md">
        <h2 class="text-3xl font-bold">
          ⭐ OFERTA LANZAMIENTO ⭐
        </h2>

        <p class="mt-4 text-gray-700">
          Impresiones Blanco y negro <span class="font-semibold"> $100</span> por hoja
        </p>

      </div>
    </div>
  </section>
  <CalculadoraImpresion client:load anillados={anillados} precios={precios}></CalculadoraImpresion>
